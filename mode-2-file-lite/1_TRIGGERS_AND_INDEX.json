{
  "trigger_id": "trigger_bundle_lite",
  "version": "3.0.0",
  "mode": "2_FILE_COMPATIBILITY",
  "execution_order": [
    "READ_FILE_1",
    "READ_FILE_2",
    "APPLY_RULES",
    "REPORT_PERSISTENCE_STATUS"
  ],
  "file_1": "1_TRIGGERS_AND_INDEX.json",
  "file_2": "2_SKILL_AND_RULES.md",
  "trigger_chain": [
    "trigger_root",
    "trigger_panduan",
    "trigger_package_save"
  ],
  "rules": {
    "max_primary_font_families": 2,
    "heading_font_roles": 1,
    "body_font_roles": 1,
    "non_latin_fallback_required_when_relevant": true,
    "prevent_visual_hallucination": true
  },
  "font_index": {
    "latin": [
      "Arial",
      "Times New Roman",
      "Helvetica",
      "Calibri",
      "Roboto",
      "Open Sans"
    ],
    "hanzi_cjk": [
      "STHeiti",
      "PingFang SC",
      "SimSun",
      "STKaiti"
    ],
    "fallback_examples_by_os": {
      "Windows": [
        "Microsoft YaHei",
        "SimSun",
        "KaiTi"
      ],
      "macOS_iOS": [
        "PingFang SC",
        "STHeiti"
      ],
      "Linux": [
        "Noto Sans CJK SC",
        "Noto Serif CJK SC"
      ]
    }
  },
  "persistence_policy": "Never claim account/model memory or plugin installation without platform confirmation."
}